# Local SQLite (default):
DB_PROVIDER=sqlite
# DATABASE_URL=sqlite:///./interviewforge.db

# Azure SQL Database (install ODBC Driver 18 for SQL Server on the host):
# DB_PROVIDER=azure_sql
# SQL_SERVER=projects-server-sziszka90.database.windows.net
# SQL_DATABASE=InterviewForgeDB
# SQL_AUTH_MODE=sql_password
# SQL_USER=your-database-user
# SQL_PASSWORD=your-database-password

# For local interactive Microsoft Entra authentication instead of SQL credentials:
# DB_PROVIDER=azure_sql
# SQL_SERVER=projects-server-sziszka90.database.windows.net
# SQL_DATABASE=InterviewForgeDB
# SQL_AUTH_MODE=entra_interactive

