# Local SQLite (default):
DB_PROVIDER=sqlite
# DATABASE_URL=sqlite:///./interviewforge.db

# Azure SQL in Container Apps with a system-assigned identity:
# DB_PROVIDER=azure_sql
# SQL_SERVER=projects-server-sziszka90.database.windows.net
# SQL_DATABASE=InterviewForgeDB
# SQL_AUTHENTICATION=ActiveDirectoryMSI

# For local Azure CLI authentication, use ActiveDirectoryDefault instead:
# SQL_AUTHENTICATION=ActiveDirectoryDefault
